# --- Production (Vercel serverless function api/chat.ts) ---
# Set these in Vercel -> Project Settings -> Environment Variables. Never prefix with VITE_.
LLM_API_KEY=
# Any OpenAI-compatible chat completions endpoint:
#   OpenAI:     https://api.openai.com/v1/chat/completions   (model e.g. gpt-4o-mini)
#   Groq:       https://api.groq.com/openai/v1/chat/completions (model e.g. llama-3.1-8b-instant)
#   OpenRouter: https://openrouter.ai/api/v1/chat/completions
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# --- Local dev only (optional) ---
# Dev uses local Ollama through the Vite proxy by default.
# VITE_OLLAMA_MODEL=llama3.2
